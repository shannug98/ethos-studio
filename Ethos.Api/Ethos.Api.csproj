<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ethos-dance-studio-neon-production-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="MediaInfo.Wrapper.Core" Version="26.1.0" />
    <PackageReference Include="MediaInfo.Core.Native" Version="26.1.0" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'ubuntu-x64' or '$(RuntimeIdentifier)' == 'linux'">
    <None Include="$(PkgMediaInfo_Core_Native)\runtimes\ubuntu-x64\native\libmediainfo.so"
          Link="libmediainfo.so"
          CopyToPublishDirectory="Always"
          Visible="false" />
    <None Include="$(PkgMediaInfo_Core_Native)\runtimes\ubuntu-x64\native\libzen.so.0"
          Link="libzen.so.0"
          CopyToPublishDirectory="Always"
          Visible="false" />
  </ItemGroup>

</Project>
